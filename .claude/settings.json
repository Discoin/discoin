{
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/secrets/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "/tmp/.nx",
        "~/.nx"
      ],
      "allowWrite": [
        "/tmp/.nx",
        "~/.nx"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "/tmp/.nx",
        "~/.nx"
      ]
    }
  }
}
