{
  "private": true,
  "name": "frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "lint": "eslint src",
    "format:check": "npx --yes prettier@3.6.2 --check src e2e smoke vite.config.ts playwright.config.ts playwright.smoke.config.ts index.html",
    "build": "vite build --mode http",
    "preview": "vite preview --mode http",
    "test": "vitest run --mode mock",
    "e2e": "playwright test",
    "dev:http": "vite --mode http",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock",
    "smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "sass": "^1.108.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "immutable": "^5.1.10"
  }
}
